# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_relevance

# --- Vision / embeddings provider: "gemini" or "ollama" ---
AI_PROVIDER=gemini

# Gemini (free tier, Google AI Studio, no card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama (fully local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=all-minilm

# --- Matching / guard tuning ---
SIMILARITY_THRESHOLD=0.62
MIN_CONFIDENCE=0.55

# --- Misc ---
ENV=development

# Pexels (free, no card) — used only by scripts/seed_corpus.py to build the corpus
PEXELS_API_KEY=your_pexels_api_key_here
